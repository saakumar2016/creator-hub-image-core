{
  "name": "@creator-hub/image-core",
  "version": "0.3.1",
  "description": "Image code shared by the Creator Hub tools: limits, decode and encode, file names, a ZIP writer, a PDF writer, PNG compression (optional entry point), downloads, and Cloudflare Pages build helpers.",
  "license": "MIT",
  "author": "Ashutosh Narayan Singh",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/saakumar2016/creator-hub-image-core.git"
  },
  "type": "module",
  "sideEffects": [
    "./dist/png/globals.js",
    "./dist/png/engine.js",
    "./dist/png/worker.js"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./limits": {
      "types": "./dist/limits.d.ts",
      "import": "./dist/limits.js"
    },
    "./names": {
      "types": "./dist/names.d.ts",
      "import": "./dist/names.js"
    },
    "./codec": {
      "types": "./dist/codec.d.ts",
      "import": "./dist/codec.js"
    },
    "./zip": {
      "types": "./dist/zip.d.ts",
      "import": "./dist/zip.js"
    },
    "./pdf": {
      "types": "./dist/pdf.d.ts",
      "import": "./dist/pdf.js"
    },
    "./png": {
      "types": "./dist/png/index.d.ts",
      "import": "./dist/png/index.js"
    },
    "./downloads": {
      "types": "./dist/downloads.d.ts",
      "import": "./dist/downloads.js"
    },
    "./pages": {
      "types": "./dist/pages/index.d.ts",
      "import": "./dist/pages/index.js"
    },
    "./package.json": "./package.json"
  },
  "bin": {
    "image-core-pages-postbuild": "./dist/pages/cli.js"
  },
  "files": [
    "dist",
    "!dist/**/*.test.*",
    "THIRD_PARTY_NOTICES.md"
  ],
  "engines": {
    "node": ">=22.12"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "prepare": "npm run build",
    "test": "vitest run",
    "lint": "eslint .",
    "typecheck": "tsc -p tsconfig.json"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "^24.13.3",
    "eslint": "^10.10.0",
    "globals": "^17.12.0",
    "jsdom": "^30.1.2",
    "typescript": "~6.0.2",
    "typescript-eslint": "^8.69.0",
    "vitest": "^5.0.3"
  },
  "dependencies": {
    "@jsquash/oxipng": "2.3.0",
    "pako": "1.0.11",
    "upng-js": "2.1.0"
  }
}
